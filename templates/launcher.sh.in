#!/bin/sh
set -eu

COMPUTER_NAME='@COMPUTER_NAME@'
TRANSPORT='@TRANSPORT@'
USB_INTERFACE='@USB_INTERFACE@'
LAN_HOST='@LAN_HOST@'
USB_HOST='@USB_HOST@'
CONTROLLER_HOST='@CONTROLLER_HOST@'
CONTROLLER_USER='@CONTROLLER_USER@'
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
STATE="$ROOT/.recovery-ssh"
KEY="$STATE/id_ed25519"
KNOWN_HOSTS="$STATE/known_hosts"
PTYWRAP="$STATE/ptywrap"
SSH_COMMAND=${RECOVERY_SSH_SSH:-/usr/bin/ssh}
IN_FIFO="${TMPDIR:-/tmp}/recovery-ssh-in.$$"
OUT_FIFO="${TMPDIR:-/tmp}/recovery-ssh-out.$$"
PTY_PID=
SSH_PID=
FX_ACCENT=
FX_DIM=
FX_OK=
FX_RESET=

terminal_fx()
{
    [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] &&
        [ "${RECOVERY_SSH_NO_ANIMATION:-0}" != 1 ]
}

setup_fx()
{
    if terminal_fx; then
        FX_ACCENT=$(printf '\033[1;36m')
        FX_DIM=$(printf '\033[2m')
        FX_OK=$(printf '\033[1;32m')
        FX_RESET=$(printf '\033[0m')
    fi
}

show_banner()
{
    printf '\n%s' "$FX_ACCENT"
    printf '             /\\\n'
    printf '            /  \\     A U R O R A\n'
    printf '           / /\\ \\    S I L I C O N\n'
    printf '          / ____ \\   RECOVERY LINK\n'
    printf '         /_/    \\_\\  %s%s\n' "$COMPUTER_NAME" "$FX_RESET"
    printf '%s         USB  >  SECURE RELAY  >  WI-FI%s\n\n' \
        "$FX_DIM" "$FX_RESET"
}

animate_launch()
{
    if ! terminal_fx; then
        printf '  [READY] Secure recovery relay initialized.\n'
        return
    fi

    for bar in \
        '#.........' \
        '##........' \
        '####......' \
        '######....' \
        '########..' \
        '##########'
    do
        printf '\r  %s[%s]%s Initializing secure recovery relay' \
            "$FX_ACCENT" "$bar" "$FX_RESET"
        sleep 0.07 2>/dev/null || break
    done
    printf '\r\033[2K  %s[READY]%s Secure recovery relay initialized.\n' \
        "$FX_OK" "$FX_RESET"
}

show_route()
{
    case "$TRANSPORT" in
        auto) route_text='USB primary  |  Wi-Fi failover armed' ;;
        usb) route_text='USB direct link' ;;
        lan) route_text='LAN / Wi-Fi link' ;;
        *) route_text="$TRANSPORT" ;;
    esac
    printf '  %s[ROUTE]%s %s\n' "$FX_ACCENT" "$FX_RESET" "$route_text"
    printf '  %s[PROFILE]%s %s\n\n' "$FX_ACCENT" "$FX_RESET" "$COMPUTER_NAME"
}

reload_if_requested()
{
    if [ -e "$STATE/reload" ]; then
        rm -f "$STATE/reload"
        printf '  %s[UPDATE]%s Relaunching the new persistent build...\n' \
            "$FX_OK" "$FX_RESET"
        exec /bin/sh "$ROOT/recovery-ssh"
    fi
}

for command in "$SSH_COMMAND" /bin/sh; do
    if [ ! -x "$command" ]; then
        echo "ERROR: Recovery does not contain $command" >&2
        exit 1
    fi
done
if [ ! -r "$KEY" ]; then
    echo "ERROR: persistent Recovery SSH key is missing: $KEY" >&2
    exit 1
fi
if [ ! -r "$KNOWN_HOSTS" ]; then
    echo "ERROR: controller host keys are missing: $KNOWN_HOSTS" >&2
    exit 1
fi
if [ ! -x "$PTYWRAP" ]; then
    echo "ERROR: Recovery PTY relay is missing or not executable: $PTYWRAP" >&2
    exit 1
fi

cleanup_relay()
{
    if [ -n "$SSH_PID" ]; then
        kill "$SSH_PID" 2>/dev/null || true
        wait "$SSH_PID" 2>/dev/null || true
        SSH_PID=
    fi
    if [ -n "$PTY_PID" ]; then
        kill "$PTY_PID" 2>/dev/null || true
        wait "$PTY_PID" 2>/dev/null || true
        PTY_PID=
    fi
    rm -f "$IN_FIFO" "$OUT_FIFO"
}

exit_with_cleanup()
{
    signal_status=$1
    cleanup_relay
    exit "$signal_status"
}

rm -f "$IN_FIFO" "$OUT_FIFO"
mkfifo "$IN_FIFO" "$OUT_FIFO"
trap 'cleanup_relay' EXIT
trap 'exit_with_cleanup 129' HUP
trap 'exit_with_cleanup 130' INT
trap 'exit_with_cleanup 143' TERM

run_endpoint()
{
    endpoint_name=$1
    endpoint_host=$2
    [ -n "$endpoint_host" ] || return 1

    printf '  %s[%s]%s Connecting to %s@%s...\n' \
        "$FX_ACCENT" "$endpoint_name" "$FX_RESET" \
        "$CONTROLLER_USER" "$endpoint_host"
    "$PTYWRAP" > "$OUT_FIFO" 2>&1 < "$IN_FIFO" &
    PTY_PID=$!

    "$SSH_COMMAND" -T \
        -i "$KEY" \
        -o BatchMode=yes \
        -o IdentitiesOnly=yes \
        -o HostKeyAlias="$CONTROLLER_HOST" \
        -o UserKnownHostsFile="$KNOWN_HOSTS" \
        -o StrictHostKeyChecking=accept-new \
        -o ConnectTimeout=3 \
        -o ConnectionAttempts=1 \
        -o ServerAliveInterval=5 \
        -o ServerAliveCountMax=2 \
        "${CONTROLLER_USER}@${endpoint_host}" \
        < "$OUT_FIFO" > "$IN_FIFO" &
    SSH_PID=$!

    if wait "$SSH_PID"; then
        endpoint_status=0
    else
        endpoint_status=$?
    fi
    SSH_PID=

    if [ -n "$PTY_PID" ]; then
        kill "$PTY_PID" 2>/dev/null || true
        wait "$PTY_PID" 2>/dev/null || true
        PTY_PID=
    fi

    if [ "$endpoint_status" -ne 0 ]; then
        printf '  %s[%s]%s Link unavailable (status %s).\n' \
            "$FX_DIM" "$endpoint_name" "$FX_RESET" "$endpoint_status"
    fi
    return "$endpoint_status"
}

setup_fx
show_banner
animate_launch
show_route
echo "  Leave this window running; disconnected links retry automatically."
echo

while :; do
    case "$TRANSPORT" in
        lan)
            run_endpoint LAN "$LAN_HOST" || true
            reload_if_requested
            ;;
        usb)
            run_endpoint USB "$USB_HOST" || true
            reload_if_requested
            ;;
        auto)
            run_endpoint USB "$USB_HOST" || true
            reload_if_requested
            printf '  %s[FAILOVER]%s USB unavailable; switching to Wi-Fi/LAN.\n' \
                "$FX_ACCENT" "$FX_RESET"
            run_endpoint LAN "$LAN_HOST" || true
            reload_if_requested
            ;;
        *)
            echo "ERROR: unsupported Recovery SSH transport: $TRANSPORT" >&2
            exit 1
            ;;
    esac
    echo "  Recovery link offline; retrying in 2 seconds..."
    sleep 2
done
